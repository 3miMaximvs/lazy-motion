{
  "name": "lazy-motion",
  "version": "0.2.1",
  "private": true,
  "description": "Les petits outils motion de LazyApps pour After Effects",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node --test tests/*.test.mjs",
    "dev": "node scripts/preview.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
